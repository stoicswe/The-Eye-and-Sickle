<component name="ProjectRunConfigurationManager">
  <!--
    Runs the client offline. Shared deliberately: without it, IntelliJ's own
    suggestion is whatever main() it finds, and a main() on a class extending
    javafx.application.Application launches the one way that CANNOT work —
    the JVM looks for JavaFX on the module path before main runs and dies with
    "JavaFX runtime components are missing", which names the wrong problem.

    Launcher does not extend Application, so the toolkit starts from inside
    main() with the classpath already established. See Launcher's class comment.
  -->
  <configuration default="false" name="Client (solo)" type="Application" factoryName="Application">
    <option name="MAIN_CLASS_NAME" value="io.github.stoicswe.eyeandsickle.client.Launcher" />
    <module name="eyeandsickle-client" />
    <!--
      ALL-UNNAMED, not javafx.graphics — and the difference is measured, not stylistic.

      JavaFX loads native graphics libraries via System::load, which JDK 24+ reports as a
      restricted-method call and a future JDK will block outright. WHICH module you grant depends
      on how the app was launched:

        * module path (what `mvn javafx:run` does)  -> --enable-native-access=javafx.graphics
        * classpath   (what an IDE does by default) -> --enable-native-access=ALL-UNNAMED

      Using the module form from the classpath produces "WARNING: Unknown module: javafx.graphics
      specified to --enable-native-access" and grants nothing, so the restricted-method warning
      appears anyway. Verified on JDK 25 with JavaFX 26.0.2: ALL-UNNAMED silences both.

      client/pom.xml keeps the javafx.graphics form because the plugin launches on the module path.
      The two are correct for their own launch mode and must not be made to match.
    -->
    <option name="VM_PARAMETERS" value="--enable-native-access=ALL-UNNAMED -Xdock:name=EAS uOS Client" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
